diff --git a/JetlinkKit/Sources/CLiteRt/jl_litert.c b/JetlinkKit/Sources/CLiteRt/jl_litert.c
--- a/JetlinkKit/Sources/CLiteRt/jl_litert.c
+++ b/JetlinkKit/Sources/CLiteRt/jl_litert.c
@@ -464,7 +464,7 @@
     // LiteRT 2.2.0 GoogleTensorOptions: burst scheduling for a bounded
     // frame stream. This changes runtime scheduling, never model precision.
     error = add_toml(m->options, "google_tensor",
-                     format("performance_mode = %d\n", 5 /* Burst in LiteRT 2.2.0 */));
+                     format("performance_mode = %d\n", 4 /* Sustained performance; wake experiment only */));
   } else if (o->gpu) {
     // LrtGetGpuOptionsIdentifier()
     error = add_toml(m->options, "gpu_options", gpu_toml(o));
diff --git a/android/app/build.gradle.kts b/android/app/build.gradle.kts
--- a/android/app/build.gradle.kts
+++ b/android/app/build.gradle.kts
@@ -35,7 +35,7 @@
         minSdk = 31
         targetSdk = 36
         versionCode = jetlinkVersionCode * 100 + 9
-        versionName = jetlinkVersion + "-clarity-tensor.9-wake-burst1"
+        versionName = jetlinkVersion + "-clarity-tensor.9-wake-sustained1"
         // The QNN runtime is arm64 only, and so is every Snapdragon with an NPU
