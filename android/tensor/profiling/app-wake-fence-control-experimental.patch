         LiteRtStatus s=wake_async_api.event((LiteRtTensorBuffer)outputs[i],&event);
         if (s==kLiteRtStatusOk && event) {
           ++events;
+          bool probe=wake_api.enabled && wake_api.enabled();
+          int fd=-1;
+          if (wake_async_api.get_fd) wake_async_api.get_fd(event,&fd);
+          if (JL_WAKE_DEADLINE) {
+            // Advisory public kernel hint on this run's borrowed fence. This
+            // neither changes the wait timeout nor bypasses the timing guard.
+            struct sync_set_deadline hint={0};
+            hint.deadline_ns=(uint64_t)(submit_start+50000000LL);
+            int rc=fd>=0 ? ioctl(fd,SYNC_IOC_SET_DEADLINE,&hint) : -1;
+            int error=fd>=0 ? errno : EBADF;
+            wake_counter("jl.deadline_rc",rc==0 ? 0 : -error);
+          }
+          wake_counter("jl.deadline_enabled",JL_WAKE_DEADLINE);
+          if (probe) fence_info(fd,submit_start,0);
           s=wake_async_api.wait(event,-1);
+          int64_t wait_return=fence_clock();
+          if (probe) fence_info(fd,submit_start,wait_return);
           if (s==kLiteRtStatusOk) s=wake_async_api.clear((LiteRtTensorBuffer)outputs[i]);
         }
         // Drain every available output even if another output failed.
