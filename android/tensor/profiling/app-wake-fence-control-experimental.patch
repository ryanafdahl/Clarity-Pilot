+// Read-only diagnostics on this inference's borrowed output fence only.
+static int64_t fence_clock(void) {
+  struct timespec ts;
+  if (clock_gettime(CLOCK_MONOTONIC,&ts)!=0) return 0;
+  return (int64_t)ts.tv_sec*1000000000LL+ts.tv_nsec;
+}
+static void fence_info(int fd,int64_t submit,int64_t returned) {
+  struct sync_fence_info detail[4]={0};
+  struct sync_file_info info={0};
+  info.num_fences=4;
+  info.sync_fence_info=(uint64_t)(uintptr_t)detail;
+  int rc=fd>=0 ? ioctl(fd,SYNC_IOC_FILE_INFO,&info) : -1;
+  wake_counter(returned ? "jl.fence_info_after_rc" : "jl.fence_info_before_rc",rc==0 ? 0 : -errno);
+  if (rc!=0) return;
+  wake_counter(returned ? "jl.fence_after_status" : "jl.fence_before_status",info.status);
+  wake_counter("jl.fence_count",info.num_fences);
+  if (info.num_fences!=1) return; // Missing/compound data is not assumed zero.
+  char label[100];
+  snprintf(label,sizeof(label),"jl.fence_driver:%.*s",32,detail[0].driver_name);
+  bool section=wake_section(label);wake_end(section);
+  if (returned) {
+    int64_t signal=(int64_t)detail[0].timestamp_ns;
+    bool valid=detail[0].status==1 && signal>=submit && signal<=returned;
+    wake_counter("jl.fence_clock_valid",valid ? 1 : 0);
+    if (valid) {
+      wake_counter("jl.submit_to_signal_us",(signal-submit)/1000);
+      wake_counter("jl.signal_to_return_us",(returned-signal)/1000);
+    }
+  }
+}
