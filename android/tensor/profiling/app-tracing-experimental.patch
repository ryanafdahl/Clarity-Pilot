+import Foundation
+
+#if os(Android)
+  import Android
+#endif
+
+/// Desk diagnostic sections. Static names and no formatting on the frame path.
+/// ATrace is enabled only while an authorized system trace selects this app.
+public enum InferenceTrace {
+  #if os(Android)
+    private final class API: @unchecked Sendable {
+      typealias Enabled = @convention(c) () -> Bool
+      typealias Begin = @convention(c) (UnsafePointer<CChar>?) -> Void
+      typealias End = @convention(c) () -> Void
+      typealias Counter = @convention(c) (UnsafePointer<CChar>?, Int64) -> Void
+      let enabled: Enabled
+      let begin: Begin
+      let end: End
+      let counter: Counter
+      init?() {
+        guard let library = dlopen("libandroid.so", RTLD_NOW),
+          let enabled = dlsym(library, "ATrace_isEnabled"),
+          let begin = dlsym(library, "ATrace_beginSection"),
+          let end = dlsym(library, "ATrace_endSection"),
+          let counter = dlsym(library, "ATrace_setCounter")
+        else { return nil }
+        self.enabled = unsafeBitCast(enabled, to: Enabled.self)
+        self.begin = unsafeBitCast(begin, to: Begin.self)
+        self.end = unsafeBitCast(end, to: End.self)
+        self.counter = unsafeBitCast(counter, to: Counter.self)
+      }
+    }
+    private static let api = API()
+  #endif
+
+  public static func measure<T>(_ name: StaticString, _ work: () throws -> T) rethrows -> T {
+    #if os(Android)
+      if let api, api.enabled() {
+        api.begin(UnsafeRawPointer(name.utf8Start).assumingMemoryBound(to: CChar.self))
+        defer { api.end() }
+        return try work()
+      }
+    #endif
+    return try work()
+  }
+
+  public static func frame(_ id: UInt32) {
+    #if os(Android)
+      if let api, api.enabled() {
+        api.counter("jl.frame_id", Int64(id))
+      }
+    #endif
+  }
+}
