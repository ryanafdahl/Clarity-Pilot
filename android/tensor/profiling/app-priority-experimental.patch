diff --git a/JetlinkKit/Sources/JetlinkServer/SessionThreadPriority.swift b/JetlinkKit/Sources/JetlinkServer/SessionThreadPriority.swift
new file mode 100755
index 0000000..9575d39
--- /dev/null
+++ b/JetlinkKit/Sources/JetlinkServer/SessionThreadPriority.swift
@@ -0,0 +1,44 @@
+#if os(Android)
+  import Android
+#endif
+
+/// A bounded Android scheduling experiment for the dedicated session thread.
+/// Ordinary fair scheduling, below UI/render priority; no affinity, clocks,
+/// real-time scheduling, or thermal changes. Restore before the thread exits.
+struct SessionThreadPriority {
+  private let previous: Int32?
+  let detail: String?
+
+  init() {
+    #if os(Android)
+      errno = 0
+      let before = getpriority(PRIO_PROCESS, 0)
+      guard errno == 0 else {
+        previous = nil
+        detail = "Android session priority unavailable: errno \(errno)"
+        return
+      }
+      if before > -4 {
+        if setpriority(PRIO_PROCESS, 0, -4) == 0 {
+          previous = before
+          detail = "Android session thread \(gettid()) nice \(before) -> -4"
+        } else {
+          previous = nil
+          detail = "Android session priority unchanged: errno \(errno)"
+        }
+      } else {
+        previous = nil
+        detail = "Android session thread \(gettid()) already nice \(before)"
+      }
+    #else
+      previous = nil
+      detail = nil
+    #endif
+  }
+
+  func restore() {
+    #if os(Android)
+      if let previous { _ = setpriority(PRIO_PROCESS, 0, previous) }
+    #endif
+  }
+}
