diff --git a/JetlinkKit/Sources/JetlinkLiteRT/TensorManifest.swift b/JetlinkKit/Sources/JetlinkLiteRT/TensorManifest.swift
new file mode 100644
index 0000000..7205dd0
--- /dev/null
+++ b/JetlinkKit/Sources/JetlinkLiteRT/TensorManifest.swift
@@ -0,0 +1,28 @@
+import Foundation
+
+/// Identity checks for a model compiled off-device; never accept another model,
+/// chip generation, or runtime just because its filename looks right.
+struct TensorManifest: Decodable {
+  let sourceSHA256: String
+  let compiledSHA256: String
+  let soc: String
+  let litert: String
+
+  enum CodingKeys: String, CodingKey {
+    case sourceSHA256 = "source_sha256", compiledSHA256 = "compiled_sha256", soc, litert
+  }
+
+  static func read(_ data: Data, source: String, chip: String) throws -> TensorManifest {
+    let manifest = try JSONDecoder().decode(Self.self, from: data)
+    guard manifest.sourceSHA256 == source else { throw LiteRtError("Tensor model source checksum mismatch") }
+    guard manifest.soc == chip.replacingOccurrences(of: " ", with: "_") else {
+      throw LiteRtError("Tensor model was compiled for another chipset")
+    }
+    guard manifest.litert == LiteRtRuntime.version else { throw LiteRtError("Tensor model runtime version mismatch") }
+    guard manifest.compiledSHA256.count == 64,
+          manifest.compiledSHA256.allSatisfy({ "0123456789abcdef".contains($0) }) else {
+      throw LiteRtError("Tensor model has an invalid compiled checksum")
+    }
+    return manifest
+  }
+}
