@@ -0,0 +1,79 @@
+import Foundation
+import Testing
+@testable import JetlinkServer
+
+private final class HealthClock: @unchecked Sendable {
+  private let lock = NSLock()
+  private var value = 0.0
+  func now() -> Double { lock.withLock { value } }
+  func advance(_ seconds: Double) { lock.withLock { value += seconds } }
+}
+
+@Suite("Tensor validation health")
+struct ValidationHealthTests {
+  @Test func missingMalformedAndExpiredTelemetryRefuse() {
+    let clock = HealthClock()
+    let health = ValidationHealth(clock: { clock.now() })
+    #expect(health.refusal() != nil)
+    health.update(["thermal_status": 0])
+    #expect(health.refusal() != nil)
+    health.update(["thermal_status": 0, "battery_c": Double.nan])
+    #expect(health.refusal() != nil)
+    health.update(["thermal_status": -1, "battery_c": 25.0])
+    #expect(health.refusal() != nil)
+    health.update(["thermal_status": 0, "battery_c": 25.0, "plugged": true, "charging": false])
+    #expect(health.refusal() == nil)
+    clock.advance(5)
+    #expect(health.refusal() != nil)
+    let snapshot = health.snapshot()["device_health"] as! [String: Any]
+    #expect(snapshot["sample_age_s"] as? Double == 5)
+    #expect(snapshot["plugged"] as? Bool == true)
+    #expect(snapshot["charging"] as? Bool == false)
+    health.update(["thermal_status": 0, "battery_c": 25.0])
+    #expect(health.refusal() == nil)
+  }
+
+  @Test(arguments: [3, 4, 5, 6]) func severeAndHigherRefuse(status: Int) {
+    let health = ValidationHealth()
+    health.update(["thermal_status": status, "battery_c": 25.0])
+    #expect(health.refusal()?.contains("severe") == true)
+  }
+
+  @Test func batteryThresholdRefuses() {
+    let health = ValidationHealth()
+    health.update(["thermal_status": 0, "battery_c": 42.9])
+    #expect(health.refusal() == nil)
+    health.update(["thermal_status": 0, "battery_c": 43.0])
+    #expect(health.refusal()?.contains("43 C") == true)
+  }
+
+  @Test func thermalStopRevokesParkedRequest() throws {
+    let health = ValidationHealth()
+    let hooks = ServerHooks(validationRefusal: { health.refusal() })
+    let backend = FlakyBackend(describing: ["validation": "parked_only"])
+    try serve(hooks: hooks, backend: backend) { _, client in
+      _ = try client.hello()
+      let ask: [String: Any] = ["sha256": String(repeating: "a", count: 64), "nbytes": 1,
+                                "frame_skip": 4, "validation_mode": "parked"]
+      try client.sendJSON(.engineReq, ask)
+      #expect(try client.recv(.error).json["error"] as? String == "validation_health")
+      health.update(["thermal_status": 0, "battery_c": 25.0])
+      try client.sendJSON(.engineReq, ask)
+      #expect(try client.recv(.engineResp).json["state"] as? String == "need_upload")
+      health.update(["thermal_status": 3, "battery_c": 35.0])
+      try client.send(.inferReq, Data(count: Wire.inferReqSize))
+      #expect(try client.recv(.error).json["error"] as? String == "validation_health")
+      health.update(["thermal_status": 0, "battery_c": 25.0])
+      try client.send(.inferReq, Data(count: Wire.inferReqSize))
+      #expect(try client.recv(.inferResp).status == Wire.Status.notReady.rawValue)
+    }
+  }
+
+  @Test func normalBackendsDoNotUseExperimentalHealthGuard() throws {
+    try serve(hooks: ServerHooks(validationRefusal: { "missing phone telemetry" })) { _, client in
+      _ = try client.hello()
+      try client.sendJSON(.engineReq, ["sha256": String(repeating: "a", count: 64), "nbytes": 1, "frame_skip": 4])
+      #expect(try client.recv(.engineResp).json["state"] as? String == "need_upload")
+    }
+  }
+}
