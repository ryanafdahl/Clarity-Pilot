@@ -0,0 +1,29 @@
+import Foundation
+import Testing
+@testable import JetlinkServer
+
+@Suite("Byte image history")
+struct ImageQueueTests {
+  @Test("Matches half history through wraps and resets for every image value", arguments: [ElementType.uint8, .float16, .float], [1, 2, 4])
+  func matchesOriginal(type: ElementType, step: Int) {
+    let bytes = ImageQueue(shape: [8, 256])
+    let original = RingQueue(shape: [8, 256])
+    let size = (8 / step) * 256 * type.size
+    let actual = UnsafeMutableRawPointer.allocate(byteCount: size, alignment: 16)
+    let expected = UnsafeMutableRawPointer.allocate(byteCount: size, alignment: 16)
+    defer { actual.deallocate(); expected.deallocate() }
+    for frame in 0..<35 {
+      if frame == 0 || frame == 19 { bytes.reset(); original.reset() }
+      if frame != 0 && frame != 19 {
+        let row = (0..<256).map { UInt8(truncatingIfNeeded: $0 + frame) }
+        row.withUnsafeBytes { source in
+          bytes.push(u8: source.baseAddress!)
+          original.push(u8: source.baseAddress!)
+        }
+      }
+      bytes.gather(step: step, into: actual, as: type)
+      original.gather(step: step, into: expected, as: type)
+      #expect(Data(bytes: actual, count: size) == Data(bytes: expected, count: size))
+    }
+  }
+}
