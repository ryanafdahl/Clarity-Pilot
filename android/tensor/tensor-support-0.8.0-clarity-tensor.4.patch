new file mode 100644
index 0000000..0d438f7
--- /dev/null
+++ b/android/scripts/fetch-tensor-runtime.py
@@ -0,0 +1,16 @@
+#!/usr/bin/env python3
+"""Fetch the official LiteRT 2.2.0 Tensor dispatch library, verifying its hash."""
+import hashlib, io, pathlib, urllib.request, zipfile
+url = 'https://github.com/google-ai-edge/LiteRT/releases/download/v2.2.0/litert_npu_runtime_libraries.zip'
+member = 'google_tensor_runtime/src/main/jni/arm64-v8a/libLiteRtDispatch_GoogleTensor.so'
+expected = '35b59265eb8595a1d28c2f69693b1cad39d1fa4a38c2c18d5d54550d079264ac'
+out = pathlib.Path(__file__).resolve().parents[1] / 'app/src/main/jniLibs/arm64-v8a/libLiteRtDispatch_GoogleTensor.so'
+if not out.exists() or hashlib.sha256(out.read_bytes()).hexdigest() != expected:
+    with urllib.request.urlopen(url, timeout=120) as response:
+        archive = zipfile.ZipFile(io.BytesIO(response.read()))
+    data = archive.read(member)
+    if hashlib.sha256(data).hexdigest() != expected:
+        raise RuntimeError('Tensor runtime checksum mismatch')
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_bytes(data)
+print(out)
