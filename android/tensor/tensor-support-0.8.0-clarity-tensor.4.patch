+import Foundation
+import Testing
+@testable import JetlinkServer
+
+@Suite("Parked Tensor protocol")
+struct ParkedGateTests {
+  @Test("Normal clients cannot acquire an experimental engine or bypass a new hello")
+  func requiresParkedRequest() throws {
+    let backend = FlakyBackend(describing: ["validation": "parked_only"])
+    try serve(backend: backend) { _, client in
+      let hello = try client.hello()
+      #expect(hello["validation"] as? String == "parked_only")
+      let ask: [String: Any] = ["sha256": String(repeating: "a", count: 64), "nbytes": 1, "frame_skip": 4]
+      try client.sendJSON(.engineReq, ask)
+      #expect(try client.recv(.error).json["error"] as? String == "parked_only")
+      try client.sendJSON(.engineReq, ask.merging(["validation_mode": "parked"]) { $1 })
+      #expect(try client.recv(.engineResp).json["state"] as? String == "need_upload")
+      // A subsequent ordinary request revokes the test client's request.
+      try client.sendJSON(.engineReq, ask)
+      #expect(try client.recv(.error).json["error"] as? String == "parked_only")
+      try client.send(.inferReq, Data(count: Wire.inferReqSize))
+      #expect(try client.recv(.inferResp).status == Wire.Status.notReady.rawValue)
+      _ = try client.hello()
+      try client.send(.inferReq, Data(count: Wire.inferReqSize))
+      #expect(try client.recv(.inferResp).status == Wire.Status.notReady.rawValue)
+    }
+  }
+}
