+import Foundation
+import Testing
+@testable import JetlinkServer
+@testable import JetlinkLiteRT
+import JetlinkONNX
+
+@Suite("Tensor protocol and health")
+struct TensorProtocolTests {
+  @Test("Normal clients request Tensor engines without a test handshake")
+  func normalRequest() throws {
+    let backend = FlakyBackend(describing: ["phone_health": "required"])
+    let hooks = ServerHooks(phoneHealthRefusal: { nil })
+    try serve(hooks: hooks, backend: backend) { _, client in
+      let hello = try client.hello()
+      #expect(hello["validation"] == nil)
+      try client.sendJSON(.engineReq, ["sha256": String(repeating: "a", count: 64), "nbytes": 1, "frame_skip": 4])
+      #expect(try client.recv(.engineResp).json["state"] as? String == "need_upload")
+    }
+  }
+
+  @Test("Both Tensor profiles keep thermal monitoring without a parked-only marker")
+  func tensorMetadata() {
+    for profile in [LiteRtProfile.tensor, .npu] {
+      let backend = LiteRtBackend(profile: profile, preparer: ONNXPreparer(), chip: "Tensor G6")
+      #expect(backend.describe()["validation"] == nil)
+      #expect(backend.describe()["phone_health"] == "required")
+    }
+  }
+
+  @Test("A Tensor session refuses missing health monitoring")
+  func missingMonitor() throws {
+    let backend = FlakyBackend(describing: ["phone_health": "required"])
+    try serve(backend: backend) { _, client in
+      _ = try client.hello()
+      try client.sendJSON(.engineReq, ["sha256": String(repeating: "a", count: 64), "nbytes": 1, "frame_skip": 4])
+      #expect(try client.recv(.error).json["error"] as? String == "phone_health")
+    }
+  }
+}
