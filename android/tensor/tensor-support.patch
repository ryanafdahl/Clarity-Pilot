--- /dev/null
+++ b/JetlinkKit/Sources/JetlinkServer/ValidationHealth.swift
@@ -0,0 +1,43 @@
+import Foundation
+
+/// App-fed, monotonic health snapshot for experimental Tensor validation.
+/// A stopped collector must expire even while the server keeps polling it.
+public final class ValidationHealth: @unchecked Sendable {
+  private let lock = NSLock()
+  private let clock: @Sendable () -> TimeInterval
+  private var fields: [String: Any] = [:]
+  private var sampledAt: TimeInterval?
+
+  public init(clock: @escaping @Sendable () -> TimeInterval = { ProcessInfo.processInfo.systemUptime }) {
+    self.clock = clock
+  }
+
+  public func update(_ value: [String: Any]) {
+    lock.withLock {
+      fields = value.filter { ["thermal_status", "battery_c", "battery_percent", "plugged", "charging", "power_save"].contains($0.key) }
+      sampledAt = clock()
+    }
+  }
+
+  public func snapshot() -> [String: Any] {
+    lock.withLock {
+      guard let sampledAt else { return [:] }
+      var result = fields
+      result["sample_age_s"] = clock() - sampledAt
+      return ["device_health": result]
+    }
+  }
+
+  /// These are conservative test stop thresholds, not a driving qualification.
+  /// No system thermal limits, charging settings or performance modes change.
+  public func refusal() -> String? {
+    guard let health = snapshot()["device_health"] as? [String: Any],
+      let age = health["sample_age_s"] as? Double, age.isFinite, age >= 0, age < 5,
+      let status = health["thermal_status"] as? Int, (0...6).contains(status),
+      let battery = health["battery_c"] as? Double, battery.isFinite
+    else { return "Fresh phone thermal telemetry is unavailable; validation stopped" }
+    if status >= 3 { return "Android severe thermal status; validation stopped" }
+    if battery >= 43 { return "Battery reached the 43 C test limit; validation stopped" }
+    return nil
+  }
+}
