@@ -0,0 +1,21 @@
+import Foundation
+
+/// Host wall times, including waits inside the runtime; not accelerator
+/// hardware counters. CPU time covers only the calling inference thread.
+public struct InferenceProfile: Sendable {
+  public let inputNs: UInt64
+  public let invokeNs: UInt64
+  public let outputNs: UInt64
+  public let threadCpuNs: UInt64
+
+  public init(inputNs: UInt64, invokeNs: UInt64, outputNs: UInt64, threadCpuNs: UInt64) {
+    self.inputNs = inputNs
+    self.invokeNs = invokeNs
+    self.outputNs = outputNs
+    self.threadCpuNs = threadCpuNs
+  }
+
+  public var description: String {
+    "input \(Double(inputNs) / 1_000_000) invoke \(Double(invokeNs) / 1_000_000) output \(Double(outputNs) / 1_000_000) inference-thread CPU \(Double(threadCpuNs) / 1_000_000) ms"
+  }
+}
