+/// Image history stays in its original byte format. All values 0...255 are
+/// exactly representable as half/float, so casting only the sampled rows is
+/// equivalent to RingQueue's half round trip and avoids it for uint8 models.
+final class ImageQueue {
+  let rows: Int
+  let rowCount: Int
+  private let buffer: UnsafeMutablePointer<UInt8>
+  private var head = 0
+
+  init(shape: [Int]) {
+    rows = shape[0]
+    rowCount = shape.dropFirst().reduce(1, *)
+    buffer = .allocate(capacity: rows * rowCount)
+    buffer.initialize(repeating: 0, count: rows * rowCount)
+  }
+
+  deinit { buffer.deallocate() }
+
+  func reset() {
+    buffer.update(repeating: 0, count: rows * rowCount)
+    head = 0
+  }
+
+  func push(u8 source: UnsafeRawPointer) {
+    UnsafeMutableRawPointer(buffer + head * rowCount).copyMemory(from: source, byteCount: rowCount)
+    head = (head + 1) % rows
+  }
+
+  func gather(step: Int, into dest: UnsafeMutableRawPointer, as type: ElementType) {
+    var out = 0
+    for logical in stride(from: 0, to: rows, by: step) {
+      let source = buffer + ((head + logical) % rows) * rowCount
+      Stage.store(u8: source, count: rowCount, into: dest + out * rowCount * type.size, as: type)
+      out += 1
+    }
+  }
+}
