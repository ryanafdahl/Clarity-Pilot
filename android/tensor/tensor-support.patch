diff --git a/android/scripts/compile-tensor.py b/android/scripts/compile-tensor.py
new file mode 100644
index 0000000..b1e2f0d
--- /dev/null
+++ b/android/scripts/compile-tensor.py
@@ -0,0 +1,36 @@
+import argparse, hashlib, json, os, pathlib
+
+def sha(path):
+    with open(path, 'rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+p = argparse.ArgumentParser(description='Compile an app-converted model for Google Tensor; SDK stays local.')
+p.add_argument('--model', type=pathlib.Path, required=True)
+p.add_argument('--source', type=pathlib.Path, required=True, help='Original ONNX model')
+p.add_argument('--sdk', type=pathlib.Path, required=True, help='Directory containing liblitert_plugin_compiler.so')
+p.add_argument('--output', type=pathlib.Path, required=True)
+p.add_argument('--soc', choices=['Tensor_G5', 'Tensor_G6'], default='Tensor_G6')
+p.add_argument('--precision', choices=['auto', 'half', 'bfloat16', 'no_truncation'], default='half')
+p.add_argument('--sharding', choices=['minimal', 'moderate', 'extensive', 'maximum'], default='minimal')
+a = p.parse_args()
+if not (a.sdk / 'liblitert_plugin_compiler.so').is_file():
+    p.error('SDK compiler library missing')
+os.environ['GOOGLE_TENSOR_COMPILER_LIB'] = str(a.sdk.resolve())
+os.environ['GOOGLE_TENSOR_BACKEND_ENABLED'] = '1'
+from ai_edge_litert.aot.aot_compile import aot_compile
+from ai_edge_litert.aot.vendors.google_tensor.target import Target, SocModel
+import importlib.metadata
+if importlib.metadata.version('ai-edge-litert') != '2.3.0':
+    p.error('Use ai-edge-litert==2.3.0')
+source_hash = sha(a.source)
+out = a.output / source_hash
+out.mkdir(parents=True, exist_ok=True)
+result = aot_compile(str(a.model), output_dir=str(out / 'work'), target=Target(SocModel(a.soc)), keep_going=False, google_tensor_truncation_type=a.precision, google_tensor_sharding_intensity=a.sharding)
+print(result.compilation_report(), flush=True)
+if result.failed_backends or len(result.models) != 1:
+    raise RuntimeError('Tensor compilation did not produce exactly one model')
+compiled = out / 'model.tflite'
+result.models[0].save(compiled, export_only=True)
+manifest = {'source_sha256': source_hash, 'compiled_sha256': sha(compiled), 'soc': a.soc, 'litert': '2.3.0', 'sdk_sha256': sha(a.sdk / 'liblitert_plugin_compiler.so'), 'precision': a.precision, 'sharding': a.sharding}
+(out / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
+print(out, flush=True)
