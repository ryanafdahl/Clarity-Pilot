+class USBInferenceBackpressure(FramesInFlight):
+  """A slow inference must not turn USB's empty write queue into a backlog
+  of expensive, already-old camera frames. The fake clock avoids sleeps."""
+
+  def setUp(self):
+    super().setUp()
+    self.ours.max_in_flight = 1
+
+  def optional(self, frame_id):
+    spec = self.client.spec
+    return self.client.infer_begin(bytes(spec.warped_nbytes), bytes(spec.packed_nbytes),
+                                   frame_id=frame_id, skip_if_busy=True)
+
+  def test_124ms_spike_does_not_queue_two_more_inferences(self):
+    clock = [100.0]
+    with mock.patch('jetlink.client.time.monotonic', side_effect=lambda: clock[0]):
+      first = self.optional(1)
+      self.assertIsNotNone(first)
+      for elapsed in (0.050, 0.100):
+        clock[0] = 100 + elapsed
+        with mock.patch.object(self.ours, 'try_send', return_value=True) as send:
+          self.assertIsNone(self.optional(int(elapsed * 20) + 1))
+          send.assert_not_called()
+        self.assertEqual(self.client.unanswered, 1)
+        self.assertFalse(self.client.dead)
+      clock[0] = 100.124
+      self.answer()
+      self.assertEqual(self.client.infer_end(first)[0], 1.0)
+      clock[0] = 100.150
+      next_seq = self.optional(4)
+      self.assertIsNotNone(next_seq)
+      self.answer()
+      self.assertEqual(self.client.infer_end(next_seq)[0], 4.0)
+      self.assertEqual(self.client.unanswered, 0)
+
+  def test_an_unanswered_request_still_expires(self):
+    clock = [100.0]
+    with mock.patch('jetlink.client.time.monotonic', side_effect=lambda: clock[0]):
+      self.optional(1)
+      clock[0] += self.client.deadline + 0.001
+      with self.assertRaisesRegex(LinkError, 'no answer to 1 frames'):
+        self.optional(2)
+      self.assertTrue(self.client.dead)
+
+  def test_endpoint_failure_is_not_hidden_by_backpressure(self):
+    self.optional(1)
+    with mock.patch.object(self.ours, 'check_health', create=True,
+                           side_effect=LinkError('endpoint shutdown')):
+      with self.assertRaisesRegex(LinkError, 'endpoint shutdown'):
+        self.optional(2)
+    self.assertTrue(self.client.dead)
+
+  def test_blocking_requests_keep_the_existing_pipeline(self):
+    t = self.answering(2)
+    self.send(1)
+    second = self.send(2)
+    self.assertEqual(self.client.infer_end(second)[0], 2.0)
+    t.join(2.0)
+
+  def test_transport_limit_is_only_on_functionfs(self):
+    from jetlink.transport.ffs import FfsTransport
+    from jetlink.transport.base import Transport
+    self.assertEqual(FfsTransport.max_in_flight, 1)
+    self.assertIsNone(Transport.max_in_flight)
