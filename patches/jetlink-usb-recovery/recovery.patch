+  def check_health(self) -> None:
+    """Check an existing transport before a background reconnect handshake.
+
+    LEAVE only queues its writes. A reset can complete them with ESHUTDOWN
+    after that call returned, while the client still looks alive. Reap those
+    completions before reusing it; otherwise HELLO wastes an entire retry.
+    Never wait for the host, open endpoints, or reject an ordinary backlog.
+    """
+    with self._tx_lock:
+      if self._closing:
+        raise LinkError('gadget closing')
+      if self._aio is not None:
+        self._collect()
+      if self._tx_error is not None:
+        raise LinkError(self._tx_error)
+    with self._cv:
+      if self._reader_error is not None:
+        raise LinkError(self._reader_error)
 
