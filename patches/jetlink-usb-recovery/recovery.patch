+def test_rejoin_health_reaps_reset_before_another_hello(sender):
+  t, aio = sender
+  aio.holding = True
+  t.send(P.Msg.LEAVE, 4, (b'{}',))
+  aio.shutdown()
+  submitted = aio.submits
+  with pytest.raises(LinkError, match='shutdown'):
+    t.check_health()
+  assert aio.submits == submitted, 'a health probe must not send a handshake'
+
+
+def test_rejoin_health_keeps_a_slow_but_live_transport(sender):
+  t, aio = sender
+  aio.holding = True
+  t.send(P.Msg.LEAVE, 4, (b'{}',))
+  t.check_health()
+  assert not t._unbound and aio.outstanding > 0
+
